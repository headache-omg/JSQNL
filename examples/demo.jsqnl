-- SCHEMA: users (id INT PRIMARY KEY, name TEXT NOT NULL, age INT, tags JSON, embedding VECTOR(3))
{"id":1,"name":"Yuki","age":16,"tags":["new"],"embedding":[1,0,0]}
{"id":2,"name":"Taro","age":20,"tags":[],"embedding":[0,1,0]}

INSERT INTO users (id, name, age) VALUES (3, 'Mika', 21);
INJECT age FROM users THE 1 WHO + 2;
INJECT tags FROM users THE 1 WHO + ["member"];
UPDATE users SET name = 'Mika O''Neil' WHERE id = 3;
DELETE FROM users WHERE id = 2;
SELECT _line, name, age FROM users WHERE age >= 18;
